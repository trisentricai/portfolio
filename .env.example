# Trisentri AI — environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Public origin of the deployed site. Used for canonical + Open Graph URLs.
VITE_SITE_URL=https://www.trisentri.ai

# Public contact address shown in the UI and used for the mailto fallback.
VITE_CONTACT_EMAIL=hello@trisentri.ai

# Optional separate careers mailbox. Falls back to VITE_CONTACT_EMAIL.
VITE_CAREERS_EMAIL=


# ---------------------------------------------------------------------------
# Contact form delivery
#
# Two mutually exclusive options. EmailJS is the simplest for a static site.
# If BOTH are configured, the custom endpoint wins (it keeps keys server-side).
# If NEITHER is configured, the form runs in honest demo mode and says so.
# ---------------------------------------------------------------------------

# --- Option A: EmailJS -----------------------------------------------------
# These three are public by design — EmailJS sends mail directly from the
# browser, so the public key ships in the bundle. That is expected, not a leak.
#
# Where to find them:
#   Service ID  -> emailjs.com dashboard > Email Services  > your service
#   Template ID -> emailjs.com dashboard > Email Templates > your template
#   Public Key  -> emailjs.com > Account > Public Key
#
# The template must define these variables (rename in the template if needed):
#   {{from_name}}  {{reply_to}}  {{company}}  {{service}}
#   {{budget}}     {{timeline}}  {{message}}  {{submitted_at}}  {{page_url}}
#
# Leave all three EMPTY to disable.
VITE_EMAILJS_SERVICE_ID=BYemdaGypKAD-JZW-rJm2
VITE_EMAILJS_TEMPLATE_ID=template_p9xoj3n
VITE_EMAILJS_PUBLIC_KEY=XV8hsrTeD-nZzdYgO

# --- Option B: your own HTTP endpoint --------------------------------------
# Receives a JSON POST with the submission and an optional bearer token.
# A 422 response may include { "errors": { "field": "message" } } to drive
# inline field errors.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_API_KEY=

# Simulated latency (ms) for the demo path so loading/success states are visible.
VITE_DEMO_LATENCY_MS=1100


# ---------------------------------------------------------------------------
# Social profiles — opt-in. Empty values are hidden in the footer and omitted
# from the Organization JSON-LD, so the site never links a profile it does not own.
# ---------------------------------------------------------------------------
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_X=


# Set to "false" to skip Three.js entirely and use the static SVG fallback.
VITE_ENABLE_HERO_3D=true
