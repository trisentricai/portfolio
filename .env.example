# Trisentri AI — environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Public origin of the deployed site. Used for canonical + Open Graph URLs.
VITE_SITE_URL=https://www.trisentri.ai

# Public contact address shown in the UI and used for the mailto fallback.
VITE_CONTACT_EMAIL=info@trisentri.ai

# Optional separate careers mailbox. Falls back to VITE_CONTACT_EMAIL.
VITE_CAREERS_EMAIL=info@trisentricai.in

# Contact form delivery endpoint.
# Leave EMPTY to keep the form in demo mode (validation runs, nothing is sent).
# Example: VITE_CONTACT_ENDPOINT=https://api.example.com/v1/inquiries
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_API_KEY=

# Simulated latency (ms) for the demo path so loading/success states are visible.
VITE_DEMO_LATENCY_MS=1100

# Social profiles are opt-in. Leave EMPTY to hide the icon in the footer and
# omit the profile from the Organization JSON-LD graph.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_X=

# Set to "false" to skip Three.js entirely and use the static SVG fallback.
VITE_ENABLE_HERO_3D=true
